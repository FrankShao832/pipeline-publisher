<?xml version="1.0" encoding="UTF-8"?>
<!--
Pipeline Publisher — Houdini Main Menu Extension (optional XML path).

Primary menu creation happens at session start: pipeline_hatch injects
HOUDINI_STARTUP_PYTHON → scripts/python/startup.py, which installs the
'Pipeline > Publish...' QMenu via publisher.dcc.houdini.menu.

This XML is only discovered if a Houdini package (pipeline_publisher.json
with an hpath entry) adds the publisher root to HOUDINI_PATH. scriptPath
expands the $PIPELINE_PUBLISHER env var set by the pipeline_hatch launcher.
-->
<mainMenu>
  <menuBar>
    <subMenu id="pipeline_publisher_menu">
      <label>Pipeline</label>

      <scriptItem>
        <label>Publish...</label>
        <scriptPath>${PIPELINE_PUBLISHER}/scripts/python/publish_launcher.py</scriptPath>
      </scriptItem>

      <separatorItem/>

    </subMenu>
  </menuBar>
</mainMenu>
